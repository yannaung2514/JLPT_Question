# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# API key. The anon key is preferred, but a service role key also works
# (it is only ever used server-side, never in the browser).
SUPABASE_ANON_KEY=your-supabase-anon-or-service-role-key
